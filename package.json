{
  "name": "ffestiniog-bikeride",
  "version": "1.0.0",
  "description": "Concept visualisation of a walking and cycling route on the mothballed Bala and Festiniog Railway corridor between Blaenau Ffestiniog and Trawsfynydd (Welsh-first, 2D and 3D, Remotion and Blender)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EG2development/ffestiniog-bikeride.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.539",
    "@remotion/three": "4.0.539",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/eslint-config-flat": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@types/react": "19.3.0",
    "@types/three": "0.186.0",
    "@types/web": "0.0.359",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src scripts tests && tsc",
    "test": "vitest run",
    "test:render": "node scripts/render-checks.mjs",
    "data:earthworks": "esbuild scripts/gen-earthworks.ts --bundle --platform=node --format=esm --outfile=out/.gen-earthworks.mjs --log-level=warning && node out/.gen-earthworks.mjs",
    "data:sync": "node scripts/sync-public-data.mjs",
    "blender:export": "esbuild scripts/blender/export-section.ts --bundle --platform=node --format=esm --outfile=out/.blender-export.mjs --log-level=warning && node out/.blender-export.mjs",
    "blender:reel": "node scripts/blender/build-reel.mjs",
    "blender:blockout": "node scripts/blender/build-blockout.mjs",
    "blender:assets": "node scripts/blender/fetch-assets.mjs",
    "still:poc": "remotion still src/index.ts Poc3DMaentwrog out/poc-still.png --gl=angle",
    "render:poc": "remotion render src/index.ts Poc3DMaentwrog out/poc-maentwrog.mp4 --gl=angle --hardware-acceleration=if-possible --video-bitrate=10M",
    "data:section": "python3 scripts/build_section_data.py --section",
    "still:reel": "remotion still src/index.ts Reel3D out/reel-still.png --gl=angle",
    "render:reel": "remotion render src/index.ts Reel3D out/reel.mp4 --gl=angle --hardware-acceleration=if-possible --video-bitrate=10M",
    "data:os-buildings": "python3 scripts/fetch_os_buildings.py --section",
    "data:candidates": "esbuild scripts/building-candidates.ts --bundle --platform=node --format=esm --outfile=out/.building-candidates.mjs --log-level=warning && node out/.building-candidates.mjs",
    "data:canopy": "python3 scripts/build_canopy.py --section",
    "data:barriers": "python3 scripts/fetch_barriers.py --section",
    "still:photo": "remotion still src/index.ts Poc3DMaentwrogPhoto out/photo-still.png --gl=angle",
    "render:photo": "remotion render src/index.ts Poc3DMaentwrogPhoto out/poc-maentwrog-photo.mp4 --gl=angle --hardware-acceleration=if-possible --video-bitrate=10M",
    "social:plan": "esbuild scripts/social/plan.ts --bundle --platform=node --format=esm --outfile=out/.social-plan.mjs --log-level=warning && node out/.social-plan.mjs",
    "social:plates": "node scripts/social/render-plates.mjs",
    "social:audio": "python scripts/social/make_audio.py out/social/public/audio",
    "social:render": "esbuild scripts/social/render-social.ts --bundle --platform=node --format=esm --packages=external --outfile=out/.social-render.mjs --log-level=warning && node out/.social-render.mjs",
    "social:qa": "node scripts/social/qa.mjs",
    "social:studio": "remotion studio --public-dir=out/social/public",
    "film:audio": "python scripts/film/make_audio.py",
    "film:encode": "node scripts/film/encode.mjs",
    "film:compare": "python scripts/film/compare.py"
  },
  "allowScripts": {
    "esbuild": false
  },
  "homepage": "https://github.com/EG2development/ffestiniog-bikeride#readme",
  "bugs": {
    "url": "https://github.com/EG2development/ffestiniog-bikeride/issues"
  }
}
