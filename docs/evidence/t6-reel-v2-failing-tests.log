"// Iteration 2: readiness through one load gate, where a test shows a fault (docs/adr/0043-load-gate-for-providers.md).
// Reel: per-section windows (docs/adr/0029-terrain-windows-per-section.md); aerial tiles come from a sibling provider (docs/adr/0033-aerial-map-tile-drape.md).
import React, { createContext, useContext, useEffect, useState } from \"react\";
import { cancelRender, continueRender, delayRender, staticFile } from \"remotion\";
import {
  expectGridBytes,
  mergeRegisters,
  validateAssets,
  validateDemHeader,
  validateLandCoverHeader,
  validateOsmLines,
  validateTrailProfile,
  type Asset,
  type Feature,
  type OsmLine,
} from \"../three-core/registers\";
import type { TrailProfile } from \"../three-core/trail\";
import type { DemGrid, LandCover } from \"../three-core/types\";

// Loads the 3D-only data (docs/design-3d.md \"Runtime data\"); used by 3D compositions only,
// so the 2D video never fetches the DEM. Read outside <ThreeCanvas> (docs/adr/0004-props-into-canvas.md).
// Every file is validated here, at the boundary, before a scene uses it.

export type Scene3DData = {
  dem: DemGrid;
  land: LandCover;
  profile: TrailProfile;
  osm: OsmLine[];
  features: Feature[];
  assets: Asset[];
};

const Scene3DDataContext = createContext<Scene3DData | null>(null);

const load = (path: string): Promise<Response> =>
  fetch(staticFile(path)).then((r) => {
    if (!r.ok) throw new Error(`${path}: HTTP ${r.status}`);
    return r;
  });
const json = (path: string): Promise<unknown> => load(path).then((r) => r.json());
const bytes = (path: string): Promise<ArrayBuffer> => load(path).then((r) => r.arrayBuffer());

/** The files a composition loads: the proof of concept's `-poc` set, or a section window under data/sections/<id>/. */
export function dataPaths(section?: string): { dem: string; land: string; profile: string; osm: string; features: string[] } {
  if (!section) return { dem: \"data/dem-poc.json\", land: \"data/landcover-poc.json\", profile: \"data/trail-profile-poc.json\", osm: \"data/osm-poc.geojson\", features: [\"data/features-3d.json\"] };
  const dir = `data/sections/${section}`;
  return { dem: `${dir}/dem.json`, land: `${dir}/landcover.json`, profile: `${dir}/trail-profile.json`, osm: `${dir}/osm.geojson`, features: [\"data/features-3d.json\", `data/features-${section}.json`] };
}

export const Scene3DDataProvider: React.FC<{ section?: string; children: React.ReactNode }> = ({ section, children }) => {
  const [handle] = useState(() => delayRender(\"Loading 3D terrain, land cover and registers\"));
  const [data, setData] = useState<Scene3DData | null>(null);

  useEffect(() => {
    let cancelled = false;
    (async () => {
      const paths = dataPaths(section);
      const dir = paths.dem.slice(0, paths.dem.lastIndexOf(\"/\"));
      const [demJson, landJson] = await Promise.all([json(paths.dem), json(paths.land)]);
      const header = validateDemHeader(demJson, paths.dem);
      const landMeta = validateLandCoverHeader(landJson, paths.land);
      const [heights, sources, classes, profile, osm, assets, ...registers] = await Promise.all([
        bytes(`${dir}/${header.file}`).then((b) => expectGridBytes(b, header, 4, header.file)),
        bytes(`${dir}/${header.sourceFile}`).then((b) => expectGridBytes(b, header, 1, header.sourceFile)),
        bytes(`${dir}/${landMeta.file}`).then((b) => expectGridBytes(b, header, 1, landMeta.file)),
        json(paths.profile),
        json(paths.osm),
        json(\"data/assets-3d.json\"),
        ...paths.features.map((f) => json(f)),
      ]);
      if (cancelled) return;
      setData({
        dem: { ...header, heights: new Float32Array(heights), sourceIndex: new Uint8Array(sources) },
        land: { legend: landMeta.legend, classes: new Uint8Array(classes) },
        profile: validateTrailProfile(profile, paths.profile),
        osm: validateOsmLines(osm, paths.osm),
        features: mergeRegisters(registers),
        assets: validateAssets(assets),
      });
    })().catch((err) => cancelRender(err));
    return () => {
      cancelled = true;
    };
  }, [handle, section]);

  // Release the hold only after the children have mounted, so <ThreeCanvas> already holds
  // the frame: releasing it straight after setData let a tab's first frame be captured
  // before the canvas had drawn (blank frame found by the t8 benchmark).
  useEffect(() => {
    if (data) continueRender(handle);
  }, [data, handle]);

  if (!data) return null;
  return <Scene3DDataContext.Provider value={data}>{children}</Scene3DDataContext.Provider>;
};

export function useScene3DData(): Scene3DData {
  const ctx = useContext(Scene3DDataContext);
  if (!ctx) throw new Error(\"useScene3DData() must be used inside <Scene3DDataProvider>\");
  return ctx;
}
