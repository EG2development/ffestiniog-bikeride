node_modules
dist
.DS_Store

# Ignore the output video from Git but not videos you import into src/.
out
# `npm run build` writes the bundle here by default
build
# Python bytecode from the pipeline scripts and the CI compile check
__pycache__/

# Environment variables
.env
.env.*

# Ruflo runtime state and secrets: only config.yaml, CAPABILITIES.md and .gitignore under .claude-flow/ are tracked
.claude-flow/*
!.claude-flow/config.yaml
!.claude-flow/CAPABILITIES.md
!.claude-flow/.gitignore
# Agent memory databases built from session content (t9 security review)
.swarm/
ruvector.db*
agentdb.rvf*
# Settings backups ruflo writes beside .claude/settings.json
.claude/*.bak-*

# Codex local configuration
.codex/

# Editor metadata and test caches
.idea/
.vitest/
